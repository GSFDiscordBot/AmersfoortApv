---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { sets } from '../../lib/sets';
import { parseRegels } from '../../lib/regels';

export function getStaticPaths() {
  return sets.map((set) => ({ params: { set: set.slug }, props: { set } }));
}

const { set } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const bron = (await getCollection('regels')).find((e) => e.id === set.slug);
const hoofdstukken = bron?.body ? parseRegels(bron.body, base) : [];

const alleArtikelen = hoofdstukken.flatMap((h) => h.artikelen);
const categorieen = [...new Set(alleArtikelen.map((a) => a.catNr).filter(Boolean))].sort(
  (a, b) => Number(a) - Number(b),
) as string[];
const telling = alleArtikelen.length;
---

<Base title={set.lang} description={set.beschrijving} active={set.slug}>
  <div class="container">
    <div class="page-head">
      <div class="kicker">Regelboek</div>
      <h1>{set.lang}</h1>
      <p>{set.beschrijving}</p>
    </div>

    {hoofdstukken.length === 0 ? (
      <div class="notice">Dit regelboek wordt nog ingevuld.</div>
    ) : (
      <div class="layout">
        <aside class="sidebar">
          <h4>Inhoud</h4>
          {hoofdstukken.map((h) => (
            <a href={`#${h.id}`} data-hoofdstuk={h.id}>{h.titel}</a>
          ))}
        </aside>

        <div>
          {telling > 0 && (
            <div class="toolbar">
              <input class="search" id="zoek" type="search" placeholder={`Zoek in ${telling} artikelen…`} autocomplete="off" />
              {categorieen.length > 0 && (
                <div class="chips" id="chips">
                  <button class="chip on" data-filter="alle">Alles</button>
                  {categorieen.map((c) => <button class="chip" data-filter={`cat:${c}`}>Categorie {c}</button>)}
                </div>
              )}
            </div>
          )}

          {hoofdstukken.map((h) => (
            <section class="hoofdstuk" id={h.id}>
              <h2>{h.titel}</h2>
              {h.introHtml && <div class="prose intro" set:html={h.introHtml} />}
              {h.artikelen.map((a) => (
                <article class="artikel" id={a.id} data-cat={a.catNr ?? ''} data-tekst={a.tekst}>
                  <header>
                    {a.nr && <span class="nr">{a.nr}</span>}
                    <h3>{a.titel}</h3>
                    {a.categorie && (
                      <span class={`badge straf ${Number(a.catNr) <= 3 ? 'laag' : Number(a.catNr) <= 6 ? 'midden' : 'hoog'}`}>
                        {a.categorie}
                      </span>
                    )}
                  </header>
                  <div class="prose" set:html={a.html} />
                </article>
              ))}
            </section>
          ))}

          <div class="geen-resultaat hidden" id="geen">Geen artikelen gevonden.</div>
        </div>
      </div>
    )}
  </div>

  <script>
    const zoek = document.getElementById('zoek') as HTMLInputElement | null;
    const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
    const artikelen = document.querySelectorAll<HTMLElement>('.artikel');
    const hoofdstukken = document.querySelectorAll<HTMLElement>('.hoofdstuk');
    const geen = document.getElementById('geen');
    let filter = 'alle';

    function toepassen() {
      const q = (zoek?.value ?? '').trim().toLowerCase();
      let zichtbaar = 0;
      artikelen.forEach((el) => {
        const okTekst = !q || (el.dataset.tekst ?? '').includes(q);
        const okFilter = !filter.startsWith('cat:') || el.dataset.cat === filter.slice(4);
        const toon = okTekst && okFilter;
        el.classList.toggle('hidden', !toon);
        if (toon) zichtbaar++;
      });
      const filtert = q !== '' || filter !== 'alle';
      hoofdstukken.forEach((h) => {
        const heeft = h.querySelectorAll('.artikel:not(.hidden)').length > 0;
        const heeftArtikelen = h.querySelectorAll('.artikel').length > 0;
        h.classList.toggle('hidden', filtert && heeftArtikelen && !heeft);
      });
      geen?.classList.toggle('hidden', zichtbaar > 0 || !filtert);
    }

    zoek?.addEventListener('input', toepassen);
    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        chips.forEach((c) => c.classList.remove('on'));
        chip.classList.add('on');
        filter = chip.dataset.filter ?? 'alle';
        toepassen();
      }),
    );

    // Actief hoofdstuk in de zijbalk markeren tijdens het scrollen
    const links = document.querySelectorAll<HTMLAnchorElement>('.sidebar a');
    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            links.forEach((l) => l.classList.toggle('active', l.dataset.hoofdstuk === e.target.id));
          }
        });
      },
      { rootMargin: '-90px 0px -70% 0px' },
    );
    hoofdstukken.forEach((h) => obs.observe(h));
  </script>
</Base>
