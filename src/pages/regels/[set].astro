---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { sets } from '../../lib/sets';
import { parseRegels } from '../../lib/regels';

export function getStaticPaths() {
  return sets.map((set) => ({ params: { set: set.slug }, props: { set } }));
}

const { set } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const bron = (await getCollection('regels')).find((e) => e.id === set.slug);
const hoofdstukken = bron?.body ? parseRegels(bron.body, base) : [];

const alleArtikelen = hoofdstukken.flatMap((h) => h.artikelen);
const categorieen = [
  ...new Set(alleArtikelen.flatMap((a) => a.straffen.map((s) => s.nr)).filter(Boolean)),
].sort((a, b) => Number(a) - Number(b)) as string[];
const telling = alleArtikelen.length;
---

<Base title={set.lang} description={set.beschrijving} active={set.slug}>
  <div class="container">
    <div class="page-head">
      <div class="kicker">Regelboek</div>
      <h1>{set.lang}</h1>
      <p>{set.beschrijving}</p>
    </div>

    {hoofdstukken.length === 0 ? (
      <div class="notice">Dit regelboek wordt nog ingevuld.</div>
    ) : (
      <div class="layout">
        <aside class="sidebar" id="sidebar">
          <h4>Inhoud</h4>
          {hoofdstukken.map((h) => (
            <div class="sb-groep">
              <a class="sb-hoofd" href={`#${h.id}`} data-id={h.id}>{h.titel}</a>
              {h.artikelen.map((a) => (
                <a class="sb-art" href={`#${a.id}`} data-id={a.id}>
                  {a.nr && <span class="sb-nr">{a.nr}</span>}
                  <span>{a.titel}</span>
                </a>
              ))}
            </div>
          ))}
        </aside>

        <div>
          {telling > 0 && (
            <div class="toolbar">
              <input class="search" id="zoek" type="search" placeholder={`Zoek in ${telling} artikelen…`} autocomplete="off" />
              <div class="chips" id="chips">
                {categorieen.length > 0 && <button class="chip on" data-filter="alle">Alles</button>}
                {categorieen.map((c) => <button class="chip" data-filter={`cat:${c}`}>Categorie {c}</button>)}
                <button class="chip toggle" id="alles-open" type="button">Alles openklappen</button>
              </div>
            </div>
          )}

          {hoofdstukken.map((h) => (
            <section class="hoofdstuk" id={h.id}>
              <h2>{h.titel}</h2>
              {h.introHtml && <div class="prose intro" set:html={h.introHtml} />}
              {h.artikelen.map((a) => (
                <details class="artikel" id={a.id} data-cat={a.straffen.map((s) => s.nr).filter(Boolean).join(' ')} data-tekst={a.tekst}>
                  <summary>
                    {a.nr && <span class="nr">{a.nr}</span>}
                    <h3>{a.titel}</h3>
                    {a.straffen.map((s) => (
                      <span class="badge straf">
                        {s.label}
                        {s.nr && (
                          <span class="meter" aria-hidden="true">
                            {Array.from({ length: 10 }, (_, i) => <i class:list={{ aan: i < Number(s.nr) }} />)}
                          </span>
                        )}
                      </span>
                    ))}
                  </summary>
                  <div class="prose" set:html={a.html} />
                </details>
              ))}
            </section>
          ))}

          <div class="geen-resultaat hidden" id="geen">Geen artikelen gevonden.</div>
        </div>
      </div>
    )}
  </div>

  <script>
    const zoek = document.getElementById('zoek') as HTMLInputElement | null;
    const chips = document.querySelectorAll<HTMLButtonElement>('.chip[data-filter]');
    const artikelen = document.querySelectorAll<HTMLDetailsElement>('details.artikel');
    const hoofdstukken = document.querySelectorAll<HTMLElement>('.hoofdstuk');
    const sidebar = document.getElementById('sidebar');
    const geen = document.getElementById('geen');
    const openKnop = document.getElementById('alles-open');
    let filter = 'alle';

    const sbLink = (id: string) => sidebar?.querySelector<HTMLElement>(`a[data-id="${CSS.escape(id)}"]`) ?? null;

    function toepassen() {
      const q = (zoek?.value ?? '').trim().toLowerCase();
      let zichtbaar = 0;
      artikelen.forEach((el) => {
        const okTekst = !q || (el.dataset.tekst ?? '').includes(q);
        const okFilter = !filter.startsWith('cat:') || (el.dataset.cat ?? '').split(' ').includes(filter.slice(4));
        const toon = okTekst && okFilter;
        el.classList.toggle('hidden', !toon);
        sbLink(el.id)?.classList.toggle('hidden', !toon);
        if (toon) {
          zichtbaar++;
          if (q) el.open = true;
        }
      });
      const filtert = q !== '' || filter !== 'alle';
      hoofdstukken.forEach((h) => {
        const heeft = h.querySelectorAll('details.artikel:not(.hidden)').length > 0;
        const heeftArtikelen = h.querySelectorAll('details.artikel').length > 0;
        const verberg = filtert && heeftArtikelen && !heeft;
        h.classList.toggle('hidden', verberg);
        sbLink(h.id)?.classList.toggle('hidden', verberg);
      });
      geen?.classList.toggle('hidden', zichtbaar > 0 || !filtert);
    }

    zoek?.addEventListener('input', toepassen);
    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        chips.forEach((c) => c.classList.remove('on'));
        chip.classList.add('on');
        filter = chip.dataset.filter ?? 'alle';
        toepassen();
      }),
    );

    // Alles openklappen / dichtklappen
    openKnop?.addEventListener('click', () => {
      const nuOpen = openKnop.dataset.open !== '1';
      artikelen.forEach((el) => { if (!el.classList.contains('hidden')) el.open = nuOpen; });
      openKnop.dataset.open = nuOpen ? '1' : '0';
      openKnop.textContent = nuOpen ? 'Alles dichtklappen' : 'Alles openklappen';
    });

    // Link naar een artikel (zijbalk of adres): klap dat artikel open
    function naarHash() {
      const id = decodeURIComponent(location.hash.slice(1));
      if (!id) return;
      const el = document.getElementById(id);
      if (el instanceof HTMLDetailsElement) {
        el.open = true;
        requestAnimationFrame(() => el.scrollIntoView({ block: 'start' }));
      }
    }
    window.addEventListener('hashchange', naarHash);
    naarHash();

    // Actief onderdeel in de zijbalk markeren tijdens het scrollen
    let actief: HTMLElement | null = null;
    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          const link = sbLink(e.target.id);
          if (!link || !sidebar) return;
          actief?.classList.remove('active');
          link.classList.add('active');
          actief = link;
          const bovenkant = link.offsetTop - sidebar.clientHeight / 3;
          if (link.offsetTop < sidebar.scrollTop || link.offsetTop > sidebar.scrollTop + sidebar.clientHeight - 60) {
            sidebar.scrollTo({ top: bovenkant });
          }
        });
      },
      { rootMargin: '-90px 0px -75% 0px' },
    );
    artikelen.forEach((a) => obs.observe(a));
    hoofdstukken.forEach((h) => obs.observe(h));
  </script>
</Base>
