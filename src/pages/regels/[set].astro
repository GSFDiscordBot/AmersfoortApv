---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { sets } from '../../lib/sets';

export function getStaticPaths() {
  return sets.map((set) => ({ params: { set: set.slug }, props: { set } }));
}

const { set } = Astro.props;

const hoofdstukken = (await getCollection('regels'))
  .filter((e) => e.id.startsWith(`${set.slug}/`))
  .sort((a, b) => a.data.volgorde - b.data.volgorde);

const alleArtikelen = hoofdstukken.flatMap((h) => h.data.artikelen);
const categorieen = [...new Set(alleArtikelen.map((a) => a.categorie).filter(Boolean))] as string[];
const heeftNiveaus = alleArtikelen.some((a) => a.niveau);
const euro = (n: number) => `€${n.toLocaleString('nl-NL')}`;
---

<Base title={set.lang} description={set.beschrijving} active={set.slug}>
  <div class="container">
    <div class="page-head">
      <div class="kicker">Regelboek</div>
      <h1>{set.lang}</h1>
      <p>{set.beschrijving}</p>
    </div>

    {hoofdstukken.length === 0 ? (
      <div class="notice">Dit regelboek wordt nog ingevuld voor de nieuwe stad.</div>
    ) : (
      <div class="layout">
        <aside class="sidebar">
          <h4>Hoofdstukken</h4>
          {hoofdstukken.map((h) => (
            <a href={`#${h.id.split('/')[1]}`} data-hoofdstuk={h.id.split('/')[1]}>{h.data.titel}</a>
          ))}
        </aside>

        <div>
          <div class="toolbar">
            <input class="search" id="zoek" type="search" placeholder="Zoek in dit regelboek…" autocomplete="off" />
            {(categorieen.length > 0 || heeftNiveaus) && (
              <div class="chips" id="chips">
                <button class="chip on" data-filter="alle">Alles</button>
                {categorieen.map((c) => <button class="chip" data-filter={`cat:${c}`}>{c}</button>)}
                {heeftNiveaus && (
                  <>
                    <button class="chip" data-filter="niv:licht">Licht</button>
                    <button class="chip" data-filter="niv:middel">Middel</button>
                    <button class="chip" data-filter="niv:zwaar">Zwaar</button>
                  </>
                )}
              </div>
            )}
          </div>

          {hoofdstukken.map((h) => (
            <section class="hoofdstuk" id={h.id.split('/')[1]}>
              <h2>{h.data.titel}</h2>
              {h.data.intro && <p class="intro">{h.data.intro}</p>}
              {h.data.artikelen.map((a) => (
                <article
                  class:list={['artikel', a.niveau]}
                  data-cat={a.categorie ?? ''}
                  data-niv={a.niveau ?? ''}
                  data-tekst={`${a.nr} ${a.titel} ${a.tekst} ${a.straf ?? ''}`.toLowerCase()}
                >
                  <header>
                    <span class="nr">Art. {a.nr}</span>
                    <h3>{a.titel}</h3>
                  </header>
                  <p>{a.tekst}</p>
                  {(a.boete !== undefined || a.straf || a.niveau || a.categorie) && (
                    <div class="badges">
                      {a.boete !== undefined && <span class="badge boete">Boete {euro(a.boete)}</span>}
                      {a.straf && <span class="badge">Straf: {a.straf}</span>}
                      {a.niveau && <span class={`badge ${a.niveau}`}>{a.niveau}</span>}
                      {a.categorie && <span class="badge">{a.categorie}</span>}
                    </div>
                  )}
                </article>
              ))}
            </section>
          ))}

          <div class="geen-resultaat hidden" id="geen">Geen artikelen gevonden.</div>
        </div>
      </div>
    )}
  </div>

  <script>
    const zoek = document.getElementById('zoek') as HTMLInputElement | null;
    const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
    const artikelen = document.querySelectorAll<HTMLElement>('.artikel');
    const hoofdstukken = document.querySelectorAll<HTMLElement>('.hoofdstuk');
    const geen = document.getElementById('geen');
    let filter = 'alle';

    function toepassen() {
      const q = (zoek?.value ?? '').trim().toLowerCase();
      let zichtbaar = 0;
      artikelen.forEach((el) => {
        const okTekst = !q || (el.dataset.tekst ?? '').includes(q);
        let okFilter = true;
        if (filter.startsWith('cat:')) okFilter = el.dataset.cat === filter.slice(4);
        if (filter.startsWith('niv:')) okFilter = el.dataset.niv === filter.slice(4);
        const toon = okTekst && okFilter;
        el.classList.toggle('hidden', !toon);
        if (toon) zichtbaar++;
      });
      hoofdstukken.forEach((h) => {
        const heeft = h.querySelectorAll('.artikel:not(.hidden)').length > 0;
        h.classList.toggle('hidden', !heeft);
      });
      geen?.classList.toggle('hidden', zichtbaar > 0);
    }

    zoek?.addEventListener('input', toepassen);
    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        chips.forEach((c) => c.classList.remove('on'));
        chip.classList.add('on');
        filter = chip.dataset.filter ?? 'alle';
        toepassen();
      }),
    );

    // Actief hoofdstuk in de zijbalk markeren tijdens het scrollen
    const links = document.querySelectorAll<HTMLAnchorElement>('.sidebar a');
    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            links.forEach((l) => l.classList.toggle('active', l.dataset.hoofdstuk === e.target.id));
          }
        });
      },
      { rootMargin: '-90px 0px -70% 0px' },
    );
    hoofdstukken.forEach((h) => obs.observe(h));
  </script>
</Base>
