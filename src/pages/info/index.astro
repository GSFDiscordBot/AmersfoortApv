---
import Base from '../../layouts/Base.astro';

// Vul hier de echte invite-links in.
const servers = [
  { naam: 'Main', doel: 'De hoofdserver van Amersfoort RolePlay', link: '#' },
  { naam: 'Support', doel: 'Hulp, vragen en tickets', link: '#' },
  { naam: 'Underworld', doel: 'De onderwereld-community', link: '#' },
  { naam: 'Government', doel: 'Overheid en hulpdiensten', link: '#' },
];
---

<Base title="Info" active="info">
  <div class="container">
    <div class="page-head">
      <div class="kicker">Informatie</div>
      <h1>Discord-servers</h1>
      <p>De officiële Discord-communities van Amersfoort RolePlay.</p>
    </div>
    <div class="section">
      <table>
        <thead><tr><th>Server</th><th>Waarvoor</th><th></th></tr></thead>
        <tbody>
          {servers.map((s) => (
            <tr>
              <td><strong>{s.naam}</strong></td>
              <td>{s.doel}</td>
              <td><a href={s.link}>Join →</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</Base>
