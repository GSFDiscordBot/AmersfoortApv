---
import Base from '../../layouts/Base.astro';

const servers = [
  { naam: 'Amersfoort RolePlay', doel: 'Main discord server van Amersfoort', link: 'https://discord.gg/afr' },
  { naam: 'Amersfoort Support', doel: 'Support discord server van Amersfoort', link: 'https://discord.gg/TUAJXAaDke' },
  { naam: 'Amersfoort Onderwereld', doel: 'Onderwereld discord server van Amersfoort', link: 'https://discord.gg/nQbs7CkVDy' },
  { naam: 'Amersfoort Overheid', doel: 'Overheids discord server van Amersfoort', link: 'https://discord.gg/qfvpCffkDp' },
];
---

<Base title="Discord-servers" active="info">
  <div class="container">
    <div class="page-head">
      <div class="kicker">Informatie</div>
      <h1>Officiële Discord-servers</h1>
      <p>Amersfoort heeft verschillende Discord-servers die zijn goedgekeurd door Beheer / Bestuur. Hier vind je belangrijke informatie.</p>
    </div>
    <div class="section">
      <div class="tw">
        <table>
          <thead><tr><th>Server</th><th>Beschrijving</th><th></th></tr></thead>
          <tbody>
            {servers.map((s) => (
              <tr>
                <td><strong>{s.naam}</strong></td>
                <td>{s.doel}</td>
                <td><a href={s.link} rel="noopener">Uitnodiging →</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</Base>
