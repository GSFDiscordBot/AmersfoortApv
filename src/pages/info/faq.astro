---
import Base from '../../layouts/Base.astro';

const vragen = [
  { v: 'Waar vind ik de regels?', a: 'Kies bovenin het menu een regelboek, zoals de APV of het Wetboek.' },
  { v: 'Hoe meld ik een overtreding?', a: 'Maak een ticket aan in de Support Discord.' },
  { v: 'Gelden de oude regels nog?', a: 'Nee. Met de nieuwe stad gelden alleen de regels op deze website.' },
];
---

<Base title="Veelgestelde vragen" active="info">
  <div class="container">
    <div class="page-head">
      <div class="kicker">Informatie</div>
      <h1>Veelgestelde vragen</h1>
    </div>
    <div class="section">
      {vragen.map((q) => (
        <div class="card" style="margin-bottom:12px">
          <h3>{q.v}</h3>
          <p>{q.a}</p>
        </div>
      ))}
    </div>
  </div>
</Base>
