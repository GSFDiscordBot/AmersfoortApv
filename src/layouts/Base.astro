---
import '../styles/global.css';
import { sets } from '../lib/sets';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  active?: string;
}
const {
  title,
  description = 'Officiële regels en wetgeving van Amersfoort RolePlay.',
  active = '',
} = Astro.props;
const paginaTitel = title ? `${title} · Amersfoort RolePlay` : 'Amersfoort RolePlay · Regels & Wetgeving';
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#05080f" />
    <title>{paginaTitel}</title>
    <link rel="icon" href={url('logo.gif')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Rajdhani:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="brand" href={url()}>
          <img src={url('logo.gif')} alt="Amersfoort RolePlay logo" />
          <span>Amersfoort RP</span>
        </a>
        <button class="nav-toggle" aria-label="Menu" id="nav-toggle">☰</button>
        <nav class="nav" id="nav">
          <a href={url()} class:list={{ active: active === 'home' }}>Home</a>
          {sets.map((s) => (
            <a href={url(`regels/${s.slug}/`)} class:list={{ active: active === s.slug }}>{s.titel}</a>
          ))}
          <a href={url('info/')} class:list={{ active: active === 'info' }}>Discord</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        © {new Date().getFullYear()} Amersfoort RolePlay · Alle regels zijn onderhevig aan wijzigingen door de staff.
      </div>
    </footer>

    <script>
      const knop = document.getElementById('nav-toggle');
      const nav = document.getElementById('nav');
      knop?.addEventListener('click', () => nav?.classList.toggle('open'));
    </script>
  </body>
</html>
